# ─────────────────────────────────────────────
# Hi-Buddy Backend 환경변수
# 이 파일을 .env로 복사해서 실제 값을 입력하세요.
# Railway/Render 배포 시: 대시보드에서 환경변수로 설정
# ─────────────────────────────────────────────

# Gemini API. 키 발급과 실제 추론의 요금·쿼터·모델 접근은 별개다.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Google API (Custom Search + YouTube)
GOOGLE_API_KEY=AIza...
GOOGLE_CSE_ID=...
YOUTUBE_API_KEY=AIza...

# 관리자 전용 토큰. Flutter에 넣거나 앱과 공유하지 않는다.
# 앱은 /api/devices/enroll에서 별도의 폐기 가능한 기기 토큰을 받는다.
APP_AUTH_TOKEN=your-secure-random-token-here

# Claude API (Anthropic) — 현재 /api/agent에서만 선택적인 첫 공급자
# https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-...
# 선택: 모델 지정 (기본값: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Groq API. 무료 한도·계정 접근은 공식 콘솔에서 확인한다.
# https://console.groq.com → API Keys → Create
GROQ_API_KEY=gsk_...
# 아래 모델 ID는 코드 기본값의 기록이며 추천 또는 실행 성공 증거가 아니다.

# Edge TTS 음성 (선택. 기본값: ko-KR-SunHiNeural)
# EDGE_TTS_VOICE=ko-KR-SunHiNeural

# ── 일반 LLM 캐스케이드. 키 없는 공급자는 자동 스킵 ──
# /api/agent만 Claude를 먼저 시도한 뒤 이 순서를 따른다.
# 일정 생성/편집·옷 제안은 이 순서부터 시작한다. 전체 실패는 503이다.
# LLM_CASCADE=gemini,upstage,groq,openrouter,cerebras
# 2026-10-12 공식표: Gemini 2.5 Flash 종료일 미공지, 기존 사용 계정만 접근.
# https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
# solar-pro3는 2026-10-30 KST 종료 예정. 11월 시험에는 사용하지 않는다.
# https://console.upstage.ai/docs/capabilities/generate/reasoning
# solar-pro4는 2026-10-14 로컬 서버에서 합성 대화2회/일정1회 성공.
# 배포 계정의 접근/요금/쿼터와 실제 사용 품질은 별도 확인한다.
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro4
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# 생체 근거 대화는 일반 동의를 승계하지 않으며 Gemini 전용이다.
# 서버 flag + 요청의 목적별 명시 동의 + 유효한 근거가 모두 필요하다.
# 켜면 실제 외부 전송/과금이 생길 수 있다. 일반 cascade로 대체하지 않는다.
HIBUDDY_PHYSIO_EXTERNAL_ENABLED=false
# 오래된 v3 memory demo는 현재 서버에서 지원하지 않는다.
USE_V3_ORCHESTRATOR=false
# 로컬 합성 시험은 local_server.py를 사용한다(dotenv 키를 읽지 않는다).
